api.na-pivo.cz {
	handle_path /media/* {
		root * /srv/napivo-media
		file_server
		header Cache-Control "public, max-age=604800, immutable"
	}

	reverse_proxy napivo-web:8000
	header {
		-Server
	}
}

na-pivo.cz {
	reverse_proxy napivo-web:8000

	header {
		-Server
	}
}

www.na-pivo.cz {
	redir https://na-pivo.cz{uri} permanent
}
