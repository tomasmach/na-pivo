# Django core
# In production (DEBUG=False) the app FAILS TO START unless SECRET_KEY is a
# strong, non-default value (must not start with "django-insecure").
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=True
# Ignored while DEBUG=True: settings.py allows all Host headers so Expo devices
# on the local network can call the dev server without editing this file.
ALLOWED_HOSTS=localhost,127.0.0.1

# Observability
LOG_LEVEL=INFO
CLIENT_EVENTS_THROTTLE_RATE=120/min

# Database (defaults to SQLite when unset)
# DATABASE_URL=postgres://user:password@localhost:5432/na_pivo

# Firmy.cz scraper settings
# Route all Firmy.cz requests through a residential proxy.
# REQUIRED in production: with DEBUG=False the app fails to start if this is
# unset. If unset in dev the scraper goes direct (dev/testing only).
FIRMY_PROXY_URL=
FIRMY_USER_AGENT=Mozilla/5.0 (Linux; Android 10; Pixel 4) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Mobile Safari/537.36
FIRMY_MIN_INTERVAL_SEC=3
FIRMY_DAILY_CAP=2000

# Cache / enrichment
HOURS_TTL_DAYS=30
FIRMY_ERROR_RETRY_COOLDOWN_MINUTES=15
SYNC_ENRICH_BUDGET=3

# Mapy.cz "pubs near" proxy (GET /v1/pubs/near)
# Server-side Mapy.cz /v1/suggest proxy so the mobile app stops calling Mapy.cz
# directly. If MAPY_API_KEY is unset the endpoint returns 503 and the client
# falls back to calling Mapy.cz itself.
MAPY_API_KEY=
MAPY_DAILY_CAP=5000
PUBS_NEAR_TTL_DAYS=7
PUBS_NEAR_MAX_AMENITY_FILTERS=5
MAP_AMENITY_CONFIDENCE_FLOOR=0.5
MAP_AMENITY_SCAN_LIMIT=200

# OpenRouter vision — AI beer-menu scan (POST /v1/pub-menu-scan)
# Uploads a menu photo to a vision model and returns a parsed beer list (no DB
# writes, no image storage). If OPENROUTER_API_KEY is unset the endpoint returns
# 503 and the feature is simply unavailable — it never blocks startup.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_TIMEOUT=30
OPENROUTER_DAILY_CAP=5000
MENU_SCAN_MAX_UPLOAD_BYTES=20971520
MENU_SCAN_MAX_REQUEST_BYTES=25165824
MENU_SCAN_IMAGE_PX=1600
MENU_SCAN_JPEG_QUALITY=80
MENU_SCAN_THROTTLE_RATE=6/min
MENU_SCAN_DAILY_PER_ACCOUNT_CAP=100

# CORS — comma-separated allowed origins for the Expo mobile app
CORS_ALLOWED_ORIGINS=http://localhost:8081,exp://localhost:8081

# ---------------------------------------------------------------------------
# User accounts — auth, OAuth providers, transactional email
# ---------------------------------------------------------------------------
# Token / one-time-token lifetimes and the soft-delete grace window.
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
# Optional absolute session-token TTL in days (empty = never expires; revoke by row).
AUTH_TOKEN_TTL_DAYS=
ACCOUNT_DELETION_GRACE_DAYS=14
# Throttle rates for the auth endpoints.
AUTH_THROTTLE_RATE=20/min
AUTH_EMAIL_THROTTLE_RATE=5/min
# Profile endpoints: nickname-availability probe + avatar upload/delete.
NICKNAME_CHECK_THROTTLE_RATE=60/min
AVATAR_THROTTLE_RATE=10/min

# Profile avatars (user-uploaded media). In DEBUG Django serves /media/ itself,
# so MEDIA_ROOT can stay at its default (<project>/media). In production set
# MEDIA_ROOT=/data/media to match the docker-compose napivo_media volume and let
# Caddy serve /media/* directly (see .env.production.example for the Caddy block).
# MEDIA_ROOT=
# AVATAR_MAX_UPLOAD_BYTES=5242880
# AVATAR_SIZE_PX=256
# AVATAR_WEBP_QUALITY=82

# Deep links used by auth emails + the web fallback / Play-required public
# account-deletion page. Verification emails sent by the API use an HTTPS API
# link so mail clients do not need to open napivo:// links directly.
APP_DEEP_LINK_SCHEME=napivo
WEB_BASE_URL=https://tomasmach.github.io/na-pivo

# Google Sign-In — OAuth client IDs from Google Cloud Console. The mobile
# google-signin lib mints the ID token under the WEB client id (so it becomes the
# token `aud` on both platforms); iOS/Android ids are accepted too. Leave all
# empty to disable Google sign-in (the endpoint returns a clear error).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Sign in with Apple — native iOS tokens have aud = the app bundle id.
# APPLE_TEAM_ID / APPLE_KEY_ID / APPLE_PRIVATE_KEY are needed only to REVOKE the
# Apple token on account deletion (Apple requires it). APPLE_PRIVATE_KEY is the
# .p8 contents; "\n" sequences are normalized to newlines.
APPLE_BUNDLE_ID=com.tomasmach.na-pivo
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Resend transactional email. EMAIL_ENABLED must be true AND RESEND_API_KEY set
# to actually send; otherwise emails are logged (dev no-op) so flows still work.
EMAIL_ENABLED=False
RESEND_API_KEY=
EMAIL_FROM=Na Pivo <noreply@napivo.cz>
