# ---------------------------------------------------------------------------
# Production environment for the na-pivo backend.
#
# Copy this to `.env` ON THE SERVER (next to docker-compose.yml) and fill in
# the real secrets. The real .env is git-ignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# Strong, unique Django secret (must NOT start with "django-insecure", or the
# app refuses to start in production).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Production mode: enables TLS hardening, secure cookies, and the fail-fast
# config checks (SECRET_KEY + FIRMY_PROXY_URL must be set).
DEBUG=False

# Keep Django admin closed on the public API host unless explicitly needed.
ENABLE_DJANGO_ADMIN=False

# API + small public invite hostname served by this backend through Caddy.
ALLOWED_HOSTS=api.na-pivo.cz,na-pivo.cz
PUBLIC_WEB_ORIGIN=https://na-pivo.cz
PUBLIC_API_ORIGIN=https://api.na-pivo.cz

# Structured JSON logs and client telemetry rate limiting.
LOG_LEVEL=INFO
CLIENT_EVENTS_THROTTLE_RATE=120/min
# Raw screen/product/error events are automatically deleted after this window.
CLIENT_EVENT_RETENTION_DAYS=90

# Optional community moderation tuning (sensible default shown).
# PUB_REPORT_GLOBAL_HIDE_THRESHOLD=3

# Optional drink logging anti-abuse tuning (sensible defaults shown).
# DRINKS_THROTTLE_RATE=30/min
# DRINK_FUTURE_GRACE_MINUTES=10
# DRINK_BACKDATE_FLAG_DAYS=60
# DRINK_BURST_LIMIT=8
# DRINK_BURST_WINDOW_MINUTES=10
# DRINK_DAILY_FLAG_CAP=21
# DRINK_DAILY_HARD_CAP=40
# LEADERBOARD_BEER_RED_DAY=25
# LEADERBOARD_BEER_RED_BURSTS=12

# Optional personal aggregate read budgets / safety horizons.
# STATS_THROTTLE_RATE=30/min
# CHALLENGES_THROTTLE_RATE=60/min
# STATS_HISTORY_YEARS=20
# STATS_MAX_DRINK_ROWS=50000

# Postgres credentials. POSTGRES_PASSWORD is consumed by the db container and
# by compose interpolation; DATABASE_URL is consumed by Django. The password
# must be IDENTICAL in both.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://napivo:CHANGE_ME@db:5432/napivo

# REQUIRED in production: residential rotating proxy for Firmy.cz. The backend
# refuses to start without it — this server has a datacenter IP, which Firmy.cz
# bounces at the GDPR consent wall.
# Format: http://user:pass@host:port  (or socks5://...)
FIRMY_PROXY_URL=

# Optional scraper / cache tuning (sensible defaults shown).
# FIRMY_MIN_INTERVAL_SEC=3
# FIRMY_DAILY_CAP=2000
# HOURS_TTL_DAYS=30
# FIRMY_ERROR_RETRY_COOLDOWN_MINUTES=15
# SYNC_ENRICH_BUDGET=3

# Backend-only Google key. Restrict it to server IPs and Geocoding API v4.
# GET /v1/pubs/near and autocomplete are local-only and never consume this key.
GOOGLE_MAPS_SERVER_API_KEY=
# Optional lookup tuning (sensible defaults shown).
# GOOGLE_MAPS_TIMEOUT=8
# GOOGLE_MAPS_DAILY_CAP=250
# GOOGLE_MAPS_LOCAL_SCAN_LIMIT=80
# PUB_LOCATION_LOOKUP_THROTTLE_RATE=30/min

# OpenRouter vision — AI beer-menu scan (POST /v1/pub-menu-scan). Uploads a menu
# photo to a vision model and returns a parsed beer list for the user to review
# (no DB writes, no image storage). Without a key the endpoint returns 503 and the
# feature is simply unavailable — it never blocks startup. The throttle + daily
# cap are the cost guards for this metered model.
OPENROUTER_API_KEY=
# Optional vision tuning (sensible defaults shown).
# OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# OPENROUTER_TIMEOUT=30
# OPENROUTER_DAILY_CAP=5000
# MENU_SCAN_MAX_UPLOAD_BYTES=20971520
# MENU_SCAN_MAX_REQUEST_BYTES=25165824
# MENU_SCAN_IMAGE_PX=1600
# MENU_SCAN_JPEG_QUALITY=80
# MENU_SCAN_THROTTLE_RATE=6/min
# MENU_SCAN_DAILY_PER_ACCOUNT_CAP=100

# ---------------------------------------------------------------------------
# OpenAI UGC moderation helper (Phase A) — REQUIRED in production (deploy
# checks pubs.E007, pubs.E008, pubs.E009). When integrated and called, the
# supplied UGC text and normalized image bytes (WebP thumbnail) are sent to
# OpenAI for moderation; server-only key, never Expo/mobile/client; not yet
# integrated (no UGC endpoints use it); fails closed if OpenAI is unreachable.
OPENAI_MODERATION_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
# Seconds; runtime and deploy checks enforce connect <= 10, read <= 30.
OPENAI_MODERATION_CONNECT_TIMEOUT_SECONDS=2
OPENAI_MODERATION_READ_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# User accounts — auth, OAuth providers, transactional email
# ---------------------------------------------------------------------------
# Lifetimes / grace window (defaults shown; uncomment to override).
# EMAIL_VERIFY_TTL_HOURS=24
# PASSWORD_RESET_TTL_HOURS=1
# AUTH_TOKEN_TTL_DAYS=
# ACCOUNT_DELETION_GRACE_DAYS=14
# AUTH_THROTTLE_RATE=20/min
# AUTH_EMAIL_THROTTLE_RATE=5/min
# NICKNAME_CHECK_THROTTLE_RATE=60/min
# AVATAR_THROTTLE_RATE=10/min

# ---------------------------------------------------------------------------
# Profile avatars (user-uploaded media)
# ---------------------------------------------------------------------------
# Avatars are stored on the local disk under MEDIA_ROOT, which MUST match the
# docker-compose named-volume mount (napivo_media:/data/media). Django does NOT
# serve media in production — Caddy serves /media/* directly from the same host
# path with a long immutable cache. Add this to the napivo site block in your
# Caddyfile (the path is the host mount point of the napivo_media volume):
#
#   handle /media/* {
#       root * /data/media
#       file_server
#       header Cache-Control "public,max-age=604800,immutable"
#   }
#
MEDIA_ROOT=/data/media
# Avatar processing limits (defaults shown; uncomment to override).
# AVATAR_MAX_UPLOAD_BYTES=5242880
# AVATAR_SIZE_PX=256
# AVATAR_WEBP_QUALITY=82

# Deep-link scheme + public web base (auth emails, deletion page). Verification
# emails sent by the API use an HTTPS API link so mail clients do not need to
# open napivo:// links directly.
APP_DEEP_LINK_SCHEME=napivo
WEB_BASE_URL=https://tomasmach.github.io/na-pivo

# Google Sign-In — OAuth client IDs from Google Cloud Console (web id is the one
# the mobile app uses; iOS/Android accepted too). Empty = Google sign-in off.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Sign in with Apple. Bundle id is the native iOS `aud`. Team/Key/PrivateKey are
# required to REVOKE the Apple token on deletion (Apple mandates it). The private
# key is the .p8 contents — paste it with literal \n between lines, e.g.
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----
APPLE_BUNDLE_ID=com.tomasmach.na-pivo
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# REQUIRED for Android App Links — SHA-256 fingerprint(s) of the production
# Android signing certificate: Google Play Console > App integrity >
# App signing key certificate (Play App Signing). EAS upload certs and local
# `keytool` output are NOT the production source of truth — they show the
# upload/direct-build certificate and may differ after Play re-signs.
# Comma-separated extras support preview/internal/direct-distribution builds;
# colons optional. Deploy check fails without it. Example: AA:BB:…:FF (64 hex)
ANDROID_APP_LINK_CERT_FINGERPRINTS=

# Linear feedback sync — disabled while BOTH key and team id are empty.
# Enabling it means account hard purge permanently deletes synced feedback
# issues via Linear's GraphQL issueDelete, so the key MUST have admin scope
# (verify the permission in Linear before setting the flag below).
# Partial config or missing confirmation fails `manage.py check --deploy`
# with pubs.E005 / pubs.E006.
# If Linear rejects or can't run issueDelete at purge time, the whole purge
# rolls back and the account stays pending for retry (fail-closed).
LINEAR_API_KEY=
LINEAR_TEAM_ID=
# Operator assertion only, NOT a live permission probe. Leave False unless you
# verified in Linear that the key above can permanently delete issues.
LINEAR_FEEDBACK_DELETE_ADMIN_CONFIRMED=False

# Resend transactional email — set EMAIL_ENABLED=True AND a key to actually send.
EMAIL_ENABLED=True
RESEND_API_KEY=
EMAIL_FROM=Na Pivo <noreply@napivo.cz>
