{
  "name": "na-pivo",
  "version": "2.3.0",
  "main": "expo-router/entry",
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    },
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-notifications"
        ]
      },
      "ios": {
        "buildFromSource": [
          "expo-location"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "dev": "bash scripts/dev-local.sh",
    "dev:detached": "node scripts/dev-detached.js",
    "dev:stop": "node scripts/dev-detached.js --stop",
    "release:ios": "node scripts/release-ios.js",
    "start:local": "EXPO_PUBLIC_BACKEND_MODE=local EXPO_PUBLIC_BACKEND_HOST=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo localhost) expo start --lan",
    "postinstall": "node scripts/patch-expo-location-heading.js && node scripts/patch-expo-widgets-live-activity.js && node scripts/patch-react-native-screens-tabs-frame.js",
    "ios": "expo run:ios",
    "ios:local": "EXPO_PUBLIC_BACKEND_MODE=local EXPO_PUBLIC_BACKEND_HOST=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo localhost) expo run:ios",
    "android": "expo run:android",
    "android:local": "EXPO_PUBLIC_BACKEND_MODE=local EXPO_PUBLIC_BACKEND_HOST=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo localhost) expo run:android",
    "audit:ci": "audit-ci --config audit-ci.jsonc && node scripts/check-zod-audit-exception.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "lint": "expo lint",
    "e2e:build": "E2E_TELEMETRY_DISABLED=1 node e2e/runtime/preflight-native-build.mjs ios && E2E_TELEMETRY_DISABLED=1 EXPO_NO_TELEMETRY=1 EXPO_NO_DOTENV=1 EXPO_PUBLIC_BACKEND_MODE=local EXPO_PUBLIC_BACKEND_URL=local EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=e2e-invalid-local-only NA_PIVO_SKIP_IOS_WIDGETS=1 expo run:ios --device generic --no-bundler --output .e2e/build",
    "e2e:critical": "E2E_TELEMETRY_DISABLED=1 node e2e/runtime/run.mjs --tag critical --exclude-tag blocked",
    "e2e:full": "E2E_TELEMETRY_DISABLED=1 node e2e/runtime/run.mjs --tag full --exclude-tag blocked",
    "e2e:blocked": "E2E_TELEMETRY_DISABLED=1 node e2e/runtime/run.mjs --tag blocked",
    "e2e:maestro:install": "E2E_TELEMETRY_DISABLED=1 MAESTRO_CLI_NO_ANALYTICS=1 bash e2e/runtime/install-maestro.sh",
    "e2e:build:android": "E2E_TELEMETRY_DISABLED=1 node e2e/runtime/build-android.mjs"
  },
  "dependencies": {
    "@expo/ui": "~58.0.22",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "country-to-currency": "^3.0.1",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "expo": "~58.0.17",
    "expo-alternate-app-icons": "8.0.0",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.18",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.18",
    "expo-widgets": "~58.0.22",
    "geokdbush": "^2.1.0",
    "kdbush": "^4.1.0",
    "lucide-react-native": "^1.61.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.101",
    "@e2e-dev/mobile": "0.12.4",
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "ai": "7.0.152",
    "audit-ci": "^7.1.0",
    "e2e": "0.21.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "react-test-renderer": "19.3.0",
    "test-renderer": "~1.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "js-yaml@^4.0.0": "4.3.2",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    },
    "xcode": {
      "uuid": "11.1.1"
    },
    "@bacons/xcode": {
      "@expo/plist": "0.8.1",
      "uuid": "11.1.1"
    },
    "image-size": "2.0.4",
    "e2e": {
      "@modelcontextprotocol/server": "2.3.1"
    }
  }
}
