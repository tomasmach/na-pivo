{
  "name": "na-pivo",
  "version": "2.1.0",
  "main": "expo-router/entry",
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-notifications"
        ]
      },
      "ios": {
        "buildFromSource": [
          "expo-location"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "dev": "bash scripts/dev-local.sh",
    "dev:detached": "node scripts/dev-detached.js",
    "dev:stop": "node scripts/dev-detached.js --stop",
    "start:local": "EXPO_PUBLIC_BACKEND_MODE=local EXPO_PUBLIC_BACKEND_HOST=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo localhost) expo start --lan",
    "postinstall": "node scripts/patch-expo-location-heading.js && node scripts/patch-expo-widgets-live-activity.js",
    "ios": "expo run:ios",
    "ios:local": "EXPO_PUBLIC_BACKEND_MODE=local EXPO_PUBLIC_BACKEND_HOST=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo localhost) expo run:ios",
    "android": "expo run:android",
    "android:local": "EXPO_PUBLIC_BACKEND_MODE=local EXPO_PUBLIC_BACKEND_HOST=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo localhost) expo run:android",
    "audit:ci": "audit-ci --config audit-ci.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/ui": "~56.0.26",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "country-to-currency": "^3.0.1",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "expo": "~56.0.21",
    "expo-apple-authentication": "~56.0.4",
    "expo-asset": "~56.0.13",
    "expo-audio": "~56.0.13",
    "expo-build-properties": "~56.0.27",
    "expo-camera": "~56.0.8",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.14",
    "expo-dev-client": "~56.0.26",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image-manipulator": "~56.0.26",
    "expo-image-picker": "~56.0.25",
    "expo-linking": "~56.0.17",
    "expo-location": "~56.0.25",
    "expo-notifications": "~56.0.25",
    "expo-router": "~56.2.20",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.26",
    "expo-splash-screen": "~56.0.15",
    "expo-status-bar": "~56.0.4",
    "expo-store-review": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.27",
    "expo-updates": "~56.0.26",
    "expo-widgets": "~56.0.27",
    "geokdbush": "^2.1.0",
    "kdbush": "^4.1.0",
    "lucide-react-native": "^1.16.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-reanimated": "4.3.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.5",
    "react-native-view-shot": "5.1.1",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "audit-ci": "^7.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "react-test-renderer": "^19.2.3",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "js-yaml@^3.0.0": "3.15.2",
    "js-yaml@^4.0.0": "4.3.2",
    "xcode": {
      "uuid": "11.1.1"
    },
    "@bacons/xcode": {
      "@expo/plist": "0.8.1",
      "uuid": "11.1.1"
    },
    "image-size": "2.0.4"
  }
}
