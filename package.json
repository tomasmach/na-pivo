{
  "name": "na-pivo",
  "version": "2.0.0",
  "main": "expo-router/entry",
  "private": true,
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-location"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "dev": "bash scripts/dev-local.sh",
    "dev:detached": "NAPIVO_KEEP_SIM=1 node scripts/dev-detached.js",
    "dev:stop": "kill -- -$(cat /tmp/napivo-dev.pid) 2>/dev/null || kill $(cat /tmp/napivo-dev.pid) 2>/dev/null || true",
    "start:local": "EXPO_PUBLIC_BACKEND_MODE=local EXPO_PUBLIC_BACKEND_HOST=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo localhost) expo start --lan",
    "postinstall": "node scripts/patch-expo-location-heading.js && node scripts/patch-expo-widgets-live-activity.js",
    "ios": "expo run:ios",
    "ios:local": "EXPO_PUBLIC_BACKEND_MODE=local EXPO_PUBLIC_BACKEND_HOST=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo localhost) expo run:ios",
    "android": "expo run:android",
    "android:local": "EXPO_PUBLIC_BACKEND_MODE=local EXPO_PUBLIC_BACKEND_HOST=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo localhost) expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "lint": "expo lint",
    "build:games": "node scripts/build-games.mjs",
    "games:dev": "node scripts/build-games.mjs && open assets/games/dice.html"
  },
  "dependencies": {
    "@expo/ui": "~56.0.25",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "cannon-es": "^0.20.0",
    "country-to-currency": "^3.0.1",
    "expo": "~56.0.19",
    "expo-apple-authentication": "~56.0.4",
    "expo-asset": "~56.0.13",
    "expo-audio": "~56.0.13",
    "expo-build-properties": "~56.0.25",
    "expo-camera": "~56.0.8",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.14",
    "expo-dev-client": "~56.0.24",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image-manipulator": "~56.0.24",
    "expo-image-picker": "~56.0.23",
    "expo-linking": "~56.0.16",
    "expo-location": "~56.0.23",
    "expo-notifications": "~56.0.23",
    "expo-router": "~56.2.18",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.24",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-store-review": "~56.0.3",
    "expo-symbols": "~56.0.7",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.25",
    "expo-updates": "~56.0.24",
    "expo-widgets": "~56.0.26",
    "geokdbush": "^2.1.0",
    "kdbush": "^4.1.0",
    "lucide-react-native": "^1.16.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "three": "^0.185.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/three": "^0.185.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "react-test-renderer": "^19.2.3",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
