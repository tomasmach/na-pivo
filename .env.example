# Copy this file to .env.local. Expo loads it for local commands.
# Expo bundles every EXPO_PUBLIC_ value into the app, so none of these values
# can be secret.

# Local Django backend for npm run dev and npm run *:local.
EXPO_PUBLIC_BACKEND_MODE=local
EXPO_PUBLIC_BACKEND_PORT=8012
# Expo usually finds this automatically. Set a LAN IP only if that fails.
# EXPO_PUBLIC_BACKEND_HOST=192.168.1.10

# Native iOS and Android builds need separate Google Maps SDK keys. Restrict
# each key to this app's bundle or package and its signing identity.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=

# Leave these empty to turn off Google Sign-In locally. OAuth client IDs are
# public identifiers, not client secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# To use a remote API instead of local Django, set its URL here and change
# EXPO_PUBLIC_BACKEND_MODE to remote.
# EXPO_PUBLIC_BACKEND_URL=https://api.example.com
