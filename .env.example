# Copy this file to .env.local. Expo automatically loads it for local commands.
# Values prefixed with EXPO_PUBLIC_ are bundled into the app and must never be
# treated as secrets.

# Local Django backend used by npm run dev / npm run *:local.
EXPO_PUBLIC_BACKEND_MODE=local
EXPO_PUBLIC_BACKEND_PORT=8012
# Usually detected from Expo. Set a LAN IP only when detection fails.
# EXPO_PUBLIC_BACKEND_HOST=192.168.1.10

# Required for native iOS / Android builds. Create separate Google Maps SDK
# keys and restrict each one to this app's bundle/package and signing identity.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=

# Optional: leave empty to disable Google Sign-In locally. These OAuth client
# IDs are public identifiers, not client secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Optional: use a remote API instead of the local backend. When this is set,
# change EXPO_PUBLIC_BACKEND_MODE to remote.
# EXPO_PUBLIC_BACKEND_URL=https://api.example.com
