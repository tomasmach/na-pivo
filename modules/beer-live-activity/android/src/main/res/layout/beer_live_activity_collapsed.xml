<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:orientation="horizontal">

  <ImageView
    android:id="@+id/beer_live_activity_count"
    android:layout_width="wrap_content"
    android:layout_height="34dp"
    android:adjustViewBounds="true"
    android:maxWidth="72dp"
    android:minWidth="20dp"
    android:scaleType="fitCenter"
    android:tint="@color/beer_live_activity_count" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="8dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/beer_live_activity_pub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/beer_live_activity_primary"
        android:textSize="15sp" />

      <TextView
        android:id="@+id/beer_live_activity_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/beer_live_activity_secondary"
        android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="3dp"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/beer_live_activity_latest"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/beer_live_activity_muted"
        android:textSize="12sp" />

      <TextView
        android:id="@+id/beer_live_activity_latest_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/beer_live_activity_muted"
        android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>

  <ImageView
    android:id="@+id/beer_live_activity_add"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="@drawable/beer_live_activity_cta_round"
    android:padding="11dp"
    android:scaleType="fitCenter"
    android:src="@drawable/beer_live_activity_plus" />
</LinearLayout>
