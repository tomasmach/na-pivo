<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="horizontal"
  android:paddingTop="4dp"
  android:paddingBottom="2dp">

  <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="64dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
      android:id="@+id/beer_live_activity_count"
      android:layout_width="wrap_content"
      android:layout_height="66dp"
      android:adjustViewBounds="true"
      android:maxWidth="96dp"
      android:scaleType="fitCenter"
      android:tint="@color/beer_live_activity_count" />

    <TextView
      android:id="@+id/beer_live_activity_word"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:fontFamily="sans-serif-medium"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:textColor="@color/beer_live_activity_secondary"
      android:textSize="13sp" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/beer_live_activity_pub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/beer_live_activity_primary"
        android:textSize="17sp" />

      <TextView
        android:id="@+id/beer_live_activity_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/beer_live_activity_secondary"
        android:textSize="15sp" />
    </LinearLayout>

    <TextView
      android:id="@+id/beer_live_activity_latest"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:textColor="@color/beer_live_activity_muted"
      android:textSize="13sp" />

    <LinearLayout
      android:id="@+id/beer_live_activity_add"
      android:layout_width="match_parent"
      android:layout_height="40dp"
      android:layout_marginTop="10dp"
      android:background="@drawable/beer_live_activity_cta"
      android:gravity="center"
      android:orientation="horizontal">

      <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/beer_live_activity_plus" />

      <TextView
        android:id="@+id/beer_live_activity_add_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/beer_live_activity_cta_text"
        android:textSize="15sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/beer_live_activity_transit"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="2dp"
      android:paddingEnd="2dp"
      android:visibility="gone">

      <ImageView
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/beer_live_activity_transit" />

      <TextView
        android:id="@+id/beer_live_activity_transit_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/beer_live_activity_secondary"
        android:textSize="12sp" />

      <TextView
        android:id="@+id/beer_live_activity_transit_prefix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:includeFontPadding="false"
        android:textColor="@color/beer_live_activity_muted"
        android:textSize="12sp" />

      <Chronometer
        android:id="@+id/beer_live_activity_transit_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:textColor="@color/beer_live_activity_muted"
        android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
