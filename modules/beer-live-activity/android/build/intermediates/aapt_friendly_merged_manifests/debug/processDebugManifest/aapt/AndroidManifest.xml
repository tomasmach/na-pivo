<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.napivo.beerliveactivity" >

    <uses-sdk android:minSdkVersion="24" />
    <!--
       Normal/app-op permission: no runtime dialog. POST_NOTIFICATIONS is still
       required separately on Android 13+, and is already declared by the app.
    -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application>
        <receiver
            android:name="com.napivo.beerliveactivity.BeerLiveActivityActionReceiver"
            android:enabled="true"
            android:exported="false" />
    </application>

</manifest>