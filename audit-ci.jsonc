{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "high": true,
  "skip-dev": true,
  // node-forge <= 1.4.0 (RSA signature verification) has no patched release. It
  // is reached through @expo/cli and the expo-updates code-signing CLI commands,
  // runs only on dev/CI machines and never ships in the app bundle. Remove the
  // entry once a patched release exists.
  // zod (memory exhaustion on oversized constrained collections) is patched only
  // in zod 4, while @expo/cli depends on zod 3 to validate project config and
  // dev-tools plugin output. The app never imports zod, so it stays out of the
  // bundle. The entry covers only the @expo/cli path, and
  // scripts/check-zod-audit-exception.js fails the audit when a vulnerable zod
  // shows up anywhere else in production. Remove both once @expo/cli ships a
  // patched zod.
  "allowlist": ["GHSA-86w9-cpqp-85rv", "GHSA-mrhx-c7xc-m3w5|expo>@expo/cli>zod"]
}
