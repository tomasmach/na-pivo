# 2.0 style exploration; only background-B.png is a build input
store-assets/variants-2.0/*
!store-assets/variants-2.0/background-B.png

# EAS uses this file instead of .gitignore. Keep the rules above in sync.
# Mobile builds retain app/, src/, assets/, locales/, modules/, vendor/,
# scripts/ (including postinstall patches), and root build configuration.

