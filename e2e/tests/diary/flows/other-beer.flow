appId: ${MAESTRO_APP_ID}
---
# A beer missing from the pub's list: typed name, then its price in the drink sheet.
- tapOn: Jiné pivo
- tapOn: Přidat pivo
- tapOn:
    id: beer-search
- inputText: ${BEER_NAME}
- tapOn: ${'Přidat „' + BEER_NAME + '“'}
- extendedWaitUntil:
    visible: 'Cena za .*'
    timeout: 10000
- tapOn: 'Cena za .*'
- extendedWaitUntil:
    visible:
      id: drink-price
    timeout: 10000
- inputText: ${BEER_PRICE}
- evalScript: ${output.local.screenshot('diary-beer-form-filled')}
- tapOn:
    id: drink-save
# A beer moments after the previous one asks before counting it.
- runFlow:
    when:
      visible: 'Další pivo .*\?'
    commands:
      - tapOn: { id: app-dialog-primary }
- assertNotVisible:
    id: drink-save
