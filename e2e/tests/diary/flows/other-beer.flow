appId: com.tomasmach.na-pivo
---
- tapOn: Vybrat jiné pivo nebo drink
- tapOn: Přidat nové pivo
- evalScript: ${output.local.screenshot('diary-beer-form-before-input')}
- tapOn:
    id: beer-form-name
- inputText: ${BEER_NAME}
- tapOn:
    id: beer-form-price
- inputText: ${BEER_PRICE}
# Numeric iOS keyboards have no standard dismiss action; the real submit stays above it.
- assertVisible:
    id: beer-form-submit
- evalScript: ${output.local.screenshot('diary-beer-form-filled')}
- tapOn:
    id: beer-form-submit
- runFlow:
    when:
      visible: Jo, připsat další pivo
    commands:
      - tapOn: Jo, připsat další pivo
- assertNotVisible:
    id: beer-form-submit
- evalScript: ${output.local.screenshot('diary-beer-counted-after-form')}
