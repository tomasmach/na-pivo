appId: ${MAESTRO_APP_ID}
---
- runFlow:
    file: ../../../maestro/route.yaml
    env:
      ROUTE: /nv/stamgast
- tapOn: Deník
- runFlow:
    when:
      notVisible: { id: diary-hero-count }
    commands:
      - tapOn: Deník
- scrollUntilVisible:
    element:
      id: diary-night
    direction: DOWN
    centerElement: true
- tapOn:
    id: diary-night
    index: 0
