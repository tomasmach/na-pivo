appId: ${MAESTRO_APP_ID}
---
- tapOn: Dopito
- extendedWaitUntil:
    visible: Na zdraví a zas příště.
    timeout: 10000
- evalScript: ${output.local.screenshot('diary-counter-receipt')}
- tapOn: Zavřít
# Wait for the receipt to close before the next tap.
- waitForAnimationToEnd:
    timeout: 5000
